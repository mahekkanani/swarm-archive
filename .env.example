# Environment variables for swarm-archive
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# ── Bee node ──────────────────────────────────────────────────────────────────
# HTTP endpoint of your local Bee node (default port for light/full node).
BEE_URL=http://localhost:1633

# ── Publisher credentials (keep secret — never tracked) ───────────────────────
# 32-byte hex secp256k1 private key used to sign Feed updates.
# Generate with: node -e "const {PrivateKey}=require('@ethersphere/core-sdk'); const k=new PrivateKey(require('crypto').randomBytes(32)); console.log(k.toHex())"
SWARM_PRIVATE_KEY=0x<your-64-hex-chars>

# ── Postage batch ─────────────────────────────────────────────────────────────
# Batch ID of your usable postage stamp (64 hex chars).
# List yours with: curl http://localhost:1633/stamps
SWARM_BATCH_ID=<your-64-hex-batch-id>
